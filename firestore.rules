rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return signedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return isAdmin() || hasRole('editor');
    }

    function isWriter() {
      return isEditor() || hasRole('writer');
    }

    function isAnalyst() {
      return isWriter() || hasRole('analyst');
    }

    function isViewer() {
      return isAnalyst() || hasRole('viewer');
    }

    function published() {
      return resource.data.isPublished == true;
    }

    match /news/{id} {
      allow read: if published() || isViewer();
      allow create: if isWriter();
      allow update: if isEditor() || (isWriter() && resource.data.createdBy == request.auth.uid && request.resource.data.isPublished == resource.data.isPublished);
      allow delete: if isAdmin();
    }

    match /galleries/{id} {
      allow read: if published() || isViewer();
      allow create: if isWriter();
      allow update: if isEditor() || (isWriter() && resource.data.createdBy == request.auth.uid && request.resource.data.isPublished == resource.data.isPublished);
      allow delete: if isAdmin();
    }

    match /polls/{id} {
      allow read: if published() || isViewer();
      allow create: if isWriter();
      allow update: if isEditor() || (isWriter() && resource.data.createdBy == request.auth.uid && request.resource.data.isPublished == resource.data.isPublished);
      allow delete: if isAdmin();
    }

    match /quizzes/{id} {
      allow read: if published() || isViewer();
      allow create: if isWriter();
      allow update: if isEditor() || (isWriter() && resource.data.createdBy == request.auth.uid && request.resource.data.isPublished == resource.data.isPublished);
      allow delete: if isAdmin();
    }

    match /reviews/{id} {
      allow read: if published() || isViewer();
      allow create: if isWriter();
      allow update: if isEditor() || (isWriter() && resource.data.createdBy == request.auth.uid && request.resource.data.isPublished == resource.data.isPublished);
      allow delete: if isAdmin();
    }

    match /crawl_sources/{id} {
      allow read: if isWriter();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /crawl_keywords/{id} {
      allow read: if isWriter();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /editorial_queue/{id} {
      allow read: if isWriter();
      allow create: if isWriter();
      allow update: if isEditor() || (
        isWriter() && (
          (resource.data.claimedBy == request.auth.uid && request.resource.data.claimedBy == request.auth.uid) ||
          ((!('claimedBy' in resource.data) || resource.data.claimedBy == null) && request.resource.data.claimedBy == request.auth.uid)
        )
      );
      allow delete: if isAdmin();
    }

    match /ads/{id} {
      allow read: if published() || resource.data.isActive == true || isViewer();
      allow create, update: if isEditor();
      allow delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if signedIn() && request.auth.uid == uid;
      allow create, delete: if isAdmin();
    }

    match /coupon_claims/{id} {
      allow create: if signedIn();
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /analytics_events/{id} {
      allow create: if signedIn();
      allow read: if isAnalyst();
      allow update, delete: if isAdmin();
    }

    match /interaction_events/{id} {
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAnalyst();
      allow delete: if isAdmin();
    }

    match /interaction_events/{id} {
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read: if isAnalyst();
      allow delete: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow create: if isViewer();
      allow update, delete: if isAdmin();
    }

    match /app_settings/{id} {
      allow read: if isViewer();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
